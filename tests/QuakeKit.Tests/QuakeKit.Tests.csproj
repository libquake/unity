<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="coverlet.collector" Version="6.0.2">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <!-- Explicitly include all test files -->
    <Compile Include="**/*.cs" Exclude="obj/**;bin/**" />
    
    <!-- Link to non-Unity-dependent source files -->
    <Compile Include="../../com.quakekit.unity/Editor/NativeBindings/NativeQFTypes.cs" 
             Link="NativeBindings/NativeQFTypes.cs" />
    <Compile Include="../../com.quakekit.unity/Editor/NativeBindings/NativeQFMap.cs" 
             Link="NativeBindings/NativeQFMap.cs" />
    <Compile Include="../../com.quakekit.unity/Editor/NativeBindings/NativeQFWad.cs" 
             Link="NativeBindings/NativeQFWad.cs" />
    <Compile Include="../../com.quakekit.unity/Editor/NativeBindings/NativeQFBsp.cs" 
             Link="NativeBindings/NativeQFBsp.cs" />
    <Compile Include="../../com.quakekit.unity/Runtime/QKitConvert.cs"
             Link="Runtime/QKitConvert.cs" />
  </ItemGroup>

  <!-- Include test data files and native library -->
  <ItemGroup>
    <None Include="../data/test.map" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../data/prototype.wad" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../data/bake.map" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../data/tooltextures.map" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../data/lightstyles.bsp" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../data/fullbright.bsp" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../data/sky_alpha.map" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../data/sky_alpha.bsp" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../data/sky_alpha.wad" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../data/lightstyles.lit" CopyToOutputDirectory="PreserveNewest" />

  </ItemGroup>

  <!-- native library of the current OS, QLIB_NATIVE=/path/to/lib overrides it (e.g. a fresh libquake build) -->
  <PropertyGroup>
    <QLibLibs>../../com.quakekit.unity/Editor/NativeBindings/Libs</QLibLibs>
    <QLibNative Condition="'$(QLIB_NATIVE)' != ''">$(QLIB_NATIVE)</QLibNative>
    <QLibNative Condition="'$(QLibNative)' == '' And $([MSBuild]::IsOSPlatform('OSX'))">$(QLibLibs)/macos/libquakelib.dylib</QLibNative>
    <QLibNative Condition="'$(QLibNative)' == '' And $([MSBuild]::IsOSPlatform('Linux'))">$(QLibLibs)/linux/libquakelib.so</QLibNative>
    <QLibNative Condition="'$(QLibNative)' == '' And $([MSBuild]::IsOSPlatform('Windows'))">$(QLibLibs)/win/quakelib.dll</QLibNative>
  </PropertyGroup>
  <ItemGroup>
    <None Include="$(QLibNative)" Link="$([System.IO.Path]::GetFileName('$(QLibNative)'))" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
